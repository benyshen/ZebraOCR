<Window x:Class="ZebraOCR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zebra OCR - 扫码枪图像识别系统"
        Width="1100"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        Closed="MainWindow_Closed">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制面板 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="选择扫码枪：" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                <ComboBox x:Name="cmbScanner" Grid.Column="1" Margin="8,0,0,0" Height="32" VerticalAlignment="Center"/>

                <Button x:Name="btnConnect" Grid.Column="2" Content="连接扫码枪" Margin="12,0,0,0"
                        Width="110" Height="34" Click="btnConnect_Click"/>

                <Button x:Name="btnCaptureOCR" Grid.Column="3" Content="扫码并OCR识别" Margin="12,0,0,0"
                        Width="140" Height="34" Click="btnCaptureOCR_Click" IsEnabled="False"/>

                <Button x:Name="btnSNAPI" Grid.Column="4" Content="切换图像模式" Margin="12,0,0,0"
                        Width="110" Height="34" Click="btnSNAPI_Click" Background="#E36C09" ToolTip="将扫码枪切换到 USB-SNAPI with Imaging 模式以支持拍照"/>

                <Button x:Name="btnRefresh" Grid.Column="5" Content="刷新设备" Margin="12,0,0,0"
                        Width="90" Height="34" Click="btnRefresh_Click" Background="#6C757D"/>

                <TextBlock x:Name="tbStatus" Grid.Column="5" VerticalAlignment="Center" TextWrapping="Wrap"
                           Padding="15,0,0,0" Foreground="#555"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="OCR模型：" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#333"/>
                    <ComboBox x:Name="cmbModel" Width="260" Height="30" Margin="8,0,0,0" VerticalAlignment="Center" SelectionChanged="cmbModel_SelectionChanged"/>
                    <TextBlock x:Name="tbModelInfo" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#888" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中间内容区域 -->
        <Grid Grid.Row="1" Margin="10,8,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧图像预览 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="图像预览 (扫码枪摄像头)" FontWeight="SemiBold" Foreground="#333"/>
                    </Border>
                    <Grid Grid.Row="1">
                        <Image x:Name="imgPreview" Stretch="Uniform" Margin="6"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="tbNoImage" Text="等待图像输入..."
                                   Foreground="#AAAAAA" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>

            <!-- 右侧 OCR 结果 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OCR 识别结果" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                            <Button x:Name="btnClear" Grid.Column="1" Content="清空" Width="60" Height="26"
                                    FontSize="12" Padding="8,2" Click="btnClear_Click" Background="#6C757D"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="txtOCRResult" Grid.Row="1"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="14"
                             Padding="8"
                             BorderThickness="0"
                             AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Background="#F8F9FA" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="tbInfo" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="tbGpuInfo" Text="GPU: --" Foreground="#2E7D32" FontWeight="SemiBold"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="tbScannerInfo" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>